{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Three-option decision card",
  "description": "Presentation only: three alternatives and an explained recommendation. Unique option IDs and recommendation references are checked by validateDecision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "question", "context", "criteria", "options", "recommendation"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "question": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "context": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": "\\S"},
    "criteria": {
      "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"}
    },
    "options": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "summary", "benefits", "tradeoffs", "effort"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 600, "pattern": "\\S"},
          "benefits": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S"}
          },
          "tradeoffs": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S"}
          },
          "effort": {"type": "string", "enum": ["low", "medium", "high"]}
        }
      }
    },
    "recommendation": {
      "type": "object", "additionalProperties": false,
      "required": ["optionId", "reason"],
      "properties": {
        "optionId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": "\\S"}
      }
    }
  }
}
